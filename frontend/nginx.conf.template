server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location ^~ /api/ {
        proxy_pass https://cycloneshield-backend-298560693045.asia-south1.run.app/;

        proxy_http_version 1.1;

        proxy_ssl_server_name on;
        proxy_ssl_name cycloneshield-backend-298560693045.asia-south1.run.app;

        proxy_set_header Host cycloneshield-backend-298560693045.asia-south1.run.app;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
