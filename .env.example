# Copy this file to .env and add your own secret locally.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.7-flash
GEMINI_MAX_ATTEMPTS=2

# Comma-separated frontend origins for FastAPI CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keep 0 for real Earth Engine/Open-Meteo/Overpass testing; use 1 only for deterministic smoke tests.
DEMO_MODE=0
CYCLONESHIELD_CACHE_TTL=21600
